{
  "baseUrl": "https://api.flatmark.dev",
  "headers": {
    "X-API-Key": "{{connection.apiKey}}"
  },
  "response": {
    "error": {
      "message": "[{{statusCode}}] {{ifempty(body.detail, body.title)}}",
      "401": {
        "type": "InvalidAccessTokenError",
        "message": "[401] The API key was not accepted. Create one at https://flatmark.dev/go/make?to=/app/api-keys"
      },
      "429": {
        "type": "RateLimitError",
        "message": "[429] {{ifempty(body.detail, body.title)}}"
      }
    }
  },
  "log": {
    "sanitize": [
      "request.headers.`X-API-Key`"
    ]
  }
}
